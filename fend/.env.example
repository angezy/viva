# Server-only URL used by Next.js to reach the Express backend. This value is
# not exposed to browsers. Use an internal service hostname or the API's HTTPS URL.
BACKEND_URL=https://api.example.com
NEXT_PUBLIC_STORE_NAME=Your Store
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional Groq key for grounded support AI. Create one at
# console.groq.com/keys and never expose it as a NEXT_PUBLIC_ variable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Browser-safe key used by the blog and support rich-text editors.
NEXT_PUBLIC_TINYMCE_API_KEY=
# Must match bend/CHAT_INTERNAL_SECRET. This is server-only because it does
# not use a NEXT_PUBLIC_ prefix.
CHAT_INTERNAL_SECRET=replace-with-the-backend-chat-internal-secret

# Must match bend/JWT_SECRET when the frontend dashboard verifies login cookies.
JWT_SECRET=replace-with-the-same-secret-used-by-the-backend
FRONTEND_URL=https://store.example.com
CORS_ORIGINS=

# Optional shared host for first-party cookies. Leave blank for host-only cookies.
COOKIE_DOMAIN=

# Canonical public URL used by the generated sitemap and robots route.
SITE_URL=https://store.example.com
CSP_REPORT_ONLY=false
# Chat presentation defaults. The dashboard AI Knowledge area manages the
# approved first greeting; these values remain safe deployment fallbacks.
# Chat bot defaults. The legacy WELUXO_CHAT_* names remain accepted for existing deployments.
CHAT_ENABLED=true
CHAT_TITLE=Your Store AI Concierge
CHAT_SUBTITLE=Answers from the Your Store help library
CHAT_GREETING=Hi - I'm the Your Store AI Concierge. What can I help you find today?
CHAT_PLACEHOLDER=Ask about orders, shipping...
CHAT_TRIGGER_LABEL=Open live chat
CHAT_THINKING=Thinking...
CHAT_FALLBACK=I could not find an exact answer in the Your Store help library. Try asking about shipping, an order, returns, payments, products, or your account.
CHAT_ERROR=I'm temporarily unavailable. Please try again.

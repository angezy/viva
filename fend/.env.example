# Server-only URL used by Next.js to reach the Express backend. This value is
# not exposed to browsers. Use an internal service hostname or the API's HTTPS URL.
BACKEND_URL=https://api.example.com

# Must match bend/JWT_SECRET when the frontend dashboard verifies login cookies.
JWT_SECRET=replace-with-the-same-secret-used-by-the-backend

# Optional shared host for first-party cookies. Leave blank for host-only cookies.
COOKIE_DOMAIN=

# Canonical public URL used by the generated sitemap and robots route.
SITE_URL=https://weluxo.com
# Chat presentation and fallback text. Restart Next.js after changing these values.
#sonner chat bot
WELUXO_CHAT_ENABLED=true
WELUXO_CHAT_TITLE=Weluxo AI Concierge
WELUXO_CHAT_SUBTITLE=Answers from the Weluxo help library
WELUXO_CHAT_GREETING=Hi - I'm the Weluxo AI Concierge. What can I help you find today?
WELUXO_CHAT_PLACEHOLDER=Ask about orders, shipping...
WELUXO_CHAT_TRIGGER_LABEL=Open live chat
WELUXO_CHAT_THINKING=Thinking...
WELUXO_CHAT_FALLBACK=I could not find an exact answer in the Weluxo help library. Try asking about shipping, an order, returns, payments, products, or your account.
WELUXO_CHAT_ERROR=I'm temporarily unavailable. Please try again.

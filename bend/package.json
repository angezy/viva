        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "graphql": "^16.11.0",
        "graphql-tag": "^2.12.0",
        "jsonwebtoken": "^9.0.2",
        "mssql": "^12.7.0",
        "multer": "^2.2.0",
        "nodemon": "^3.1.10",
        "sanitize-html": "^2.17.7"

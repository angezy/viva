# MSSQL and application settings
DB_SERVER=your-sql-server
DB_USER=your-sql-user
DB_PASSWORD=your-sql-password
DB_DATABASE=your-database
DB_PORT=1433
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# Deployment-only migration identity. Do not configure these on the web app host
# unless a controlled migration job is actively running.
MIGRATION_DB_SERVER=your-sql-server
MIGRATION_DB_USER=your-deployment-only-user
MIGRATION_DB_PASSWORD=your-deployment-only-password
MIGRATION_DB_DATABASE=your-database
MIGRATION_DB_PORT=1433
MIGRATION_DB_ENCRYPT=true
MIGRATION_DB_TRUST_SERVER_CERT=false
ALLOW_SCHEMA_MIGRATIONS=false
MIGRATION_IDENTITY_CONFIRMED=false
BACKUP_RESTORE_CONFIRMED=false
JWT_SECRET=replace-with-a-long-random-secret
CHAT_SESSION_SECRET=replace-with-a-long-random-chat-session-secret
# Must match the server-only frontend value. It authenticates assistant
# transcript records and must never use a NEXT_PUBLIC_ name.
CHAT_INTERNAL_SECRET=replace-with-a-long-random-chat-internal-secret
NODE_ENV=production
PORT=5000
# Comma-separated trusted reverse-proxy CIDRs. Do not use blanket TRUST_PROXY=true.
# Configure the private load-balancer network or current Cloudflare egress ranges.
TRUST_PROXY_CIDRS=loopback
JSON_BODY_LIMIT=1mb

# SendPulse client credentials (server-only; never add these to frontend env files)
SENDPULSE_ENABLED=true
SENDPULSE_API_BASE_URL=https://api.sendpulse.com
SENDPULSE_CLIENT_ID=replace-with-sendpulse-client-id
SENDPULSE_CLIENT_SECRET=replace-with-sendpulse-client-secret
SENDPULSE_FROM_EMAIL=no-reply@store.example.com
SENDPULSE_FROM_NAME=Your Store Support
# Required when an admin recipient is the same as SENDPULSE_FROM_EMAIL.
# This must be a different sender verified in SendPulse.
SENDPULSE_ADMIN_FROM_EMAIL=support@store.example.com
SENDPULSE_ADMIN_FROM_NAME=Your Store Notifications
SUPPORT_ADMIN_EMAIL=support@store.example.com
SUPPORT_ADMIN_NAME=Your Store Support
# Optional when the backend and frontend are deployed separately. In this
# repository the backend automatically reads fend/data/customer-email-journey.json.
MARKETING_JOURNEY_PATH=
MARKETING_EMAIL_AUTOMATION_ENABLED=true
MARKETING_EMAIL_POLL_INTERVAL_MS=60000
# Owner/operations recipient for paid-order and CJ fulfillment alerts.
OWNER_EMAIL=owner@example.com
APP_BASE_URL=https://store.example.com


# Supplier API (server-only; never expose any of these in NEXT_PUBLIC_* variables).
# Create this key in the CJ API app. CJ_API_TOKEN and CJ_TOKEN remain supported
# for deployments already using the older product-import integration.
CJ_API_KEY=
# Optional, for deployments that inject a rotated CJ access token themselves.
CJ_ACCESS_TOKEN=
# Custom websites use CJ's API store flow. Imports save products and
# variants to CJ and then create a product connection.
CJ_STORE_SYNC_ENABLED=true
# Optional when more than one CJ shop exists; blank uses the account API shop.
CJ_SHOP_ID=
CJ_PRODUCT_CONNECTION_LOGISTICS=PacketPlus
CJ_CONNECTION_DEFAULT_AREA=1
CJ_CONNECTION_IGNORE_INVENTORY=0
CJ_SOURCE_COUNTRY_CODE=CN
CJ_SOURCE_COUNTRY=China
CJ_TARGET_COUNTRY_CODE=US
CJ_TARGET_COUNTRY=United States
# The tracking page refreshes CJ at most once per order during this interval.
CJ_TRACKING_SYNC_TTL_SECONDS=300
# Set true only after migrating database/014 and configuring the fields below.
# Each paid, confirmed website order is then submitted to CJ Create Order V3.
CJ_FULFILLMENT_ENABLED=false
# CJ's ship-from country. Checkout fetches live CJ logistics services so the
# customer can choose one for their cart and destination.
CJ_FROM_COUNTRY_CODE=CN
# Optional legacy fallback for orders created before live shipping selection.
CJ_LOGISTIC_NAME=
# CJ Logistics mode: 2 means CJ ships through its own logistics; 1/3 require
# a warehouse and waybill workflow.
CJ_SHOP_LOGISTICS_TYPE=2
CJ_REQUEST_TIMEOUT_MS=20000
# CJ commonly limits an API endpoint/account to one request per second.
CJ_REQUEST_MIN_INTERVAL_MS=1100
# Use only for CJ sandbox testing; it never creates real fulfillment.
CJ_SANDBOX_MODE=false
# When false (recommended), paid storefront orders are created in CJ but are
# not charged. Set true only with CJ_SANDBOX_MODE=false to deduct your CJ
# account balance automatically after the customer payment succeeds.
CJ_AUTO_PAY_ENABLED=false
# Legacy fallback for old Store Product order-flow integrations. Standard CJ
# variant-based fulfillment does not require this field.
CJ_STORE_PRODUCT_IMAGE_DEFAULT=

# HyperSKU Open API (server-only). Request API access from your HyperSKU
# account manager, then store the API key and either an access token or the
# API username/password here. Never add these to NEXT_PUBLIC_* variables.
HYPERSKU_ENABLED=false
HYPERSKU_API_BASE_URL=https://api.hypersku.com
HYPERSKU_API_KEY=
HYPERSKU_ACCESS_TOKEN=
HYPERSKU_USERNAME=
HYPERSKU_PASSWORD=
HYPERSKU_TOKEN_URL=https://api.hypersku.com/api/auth/admin/token
# HyperSKU's documented Authorization header uses the credential directly.
# Set to Bearer only if your issued credential explicitly requires it.
HYPERSKU_AUTH_HEADER_PREFIX=
HYPERSKU_STORE_CODE=
HYPERSKU_REQUEST_TIMEOUT_MS=20000
HYPERSKU_REQUEST_MIN_INTERVAL_MS=250
# Google OAuth (server-only). Add the callback URL to the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Keep this equal to the public frontend callback URL, for example:
# https://store.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://store.example.com/api/auth/google/callback
# Optional when the frontend and backend use different public hosts.
FRONTEND_URL=https://store.example.com
CORS_ORIGINS=
STORE_NAME=Your Store
STORE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com
STORE_CURRENCY=USD
STORE_LOCALE=en-US
STORE_TIMEZONE=UTC
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_USERNAME=
ALLOW_OWNER_MIGRATION=false

# Customer password-reset controls
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_DELAY_SECONDS=60

# Telegram customer-chat bridge (server-only)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-your-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Optional public callback URL. In production this defaults to
# APP_BASE_URL/api/telegram/webhook; leave blank for local development.
TELEGRAM_WEBHOOK_URL=

# Payments: Stripe Checkout is the only provider enabled by the secure flow.
# Leave PAYMENT_PROVIDER blank until the Stripe account and callbacks are ready.
PAYMENT_PROVIDER=stripe
# Hosted Checkout is created server-side and redirects the browser to Stripe;
# no STRIPE_PUBLISHABLE_KEY is needed unless this changes to Elements/embedded Checkout.
STRIPE_SECRET_KEY=
# Separate signing secret copied from the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
CHECKOUT_CURRENCY=USD
MAX_CART_QUANTITY=99
MALWARE_SCANNER_MODE=clamav
MALWARE_SCAN_TIMEOUT_MS=30000

# Distributed database-backed abuse controls (migration 009 required).
RATE_LIMIT_KEY_SECRET=replace-with-a-separate-long-random-secret
SESSION_FINGERPRINT_SECRET=replace-with-a-separate-long-random-secret
SECURITY_EVENT_KEY_SECRET=replace-with-a-separate-long-random-secret
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MESSAGING_MAX=30
RATE_LIMIT_CHECKOUT_MAX=30

# GraphQL is disabled unless explicitly enabled. Keep introspection off in production.
GRAPHQL_ENABLED=false
GRAPHQL_INTROSPECTION=false

# MSSQL and application settings
DB_SERVER=your-sql-server
DB_USER=your-sql-user
DB_PASSWORD=your-sql-password
DB_DATABASE=your-database
DB_PORT=1433
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

# SendPulse client credentials (server-only; never add these to frontend env files)
SENDPULSE_ENABLED=true
SENDPULSE_API_BASE_URL=https://api.sendpulse.com
SENDPULSE_CLIENT_ID=replace-with-sendpulse-client-id
SENDPULSE_CLIENT_SECRET=replace-with-sendpulse-client-secret
SENDPULSE_FROM_EMAIL=no-reply@weluxo.com
SENDPULSE_FROM_NAME=Weluxo Support
# Required when an admin recipient is the same as SENDPULSE_FROM_EMAIL.
# This must be a different sender verified in SendPulse.
SENDPULSE_ADMIN_FROM_EMAIL=support@weluxo.com
SENDPULSE_ADMIN_FROM_NAME=Weluxo Notifications
SUPPORT_ADMIN_EMAIL=no-reply@weluxo.com
SUPPORT_ADMIN_NAME=Weluxo Support
APP_BASE_URL=https://weluxo.com

# Google OAuth (server-only). Add the callback URL to the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Keep this equal to the public frontend callback URL, for example:
# https://weluxo.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://weluxo.com/api/auth/google/callback
# Optional when the frontend and backend use different public hosts.
FRONTEND_URL=https://weluxo.com

# Customer password-reset controls
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_DELAY_SECONDS=60

# Telegram customer-chat bridge (server-only)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-your-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Optional public callback URL. In production this defaults to
# APP_BASE_URL/api/telegram/webhook; leave blank for local development.
TELEGRAM_WEBHOOK_URL=

# Payments: Stripe Checkout is the only provider enabled by the secure flow.
# Leave PAYMENT_PROVIDER blank until the Stripe account and callbacks are ready.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=


DB_SERVER=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=1433
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
# Used only by the explicit migration runner; keep separate from DB_USER.
MIGRATION_DB_SERVER=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
MIGRATION_DB_DATABASE=
MIGRATION_DB_PORT=1433
MIGRATION_DB_ENCRYPT=true
MIGRATION_DB_TRUST_SERVER_CERT=false
ALLOW_SCHEMA_MIGRATIONS=false
MIGRATION_IDENTITY_CONFIRMED=false
BACKUP_RESTORE_CONFIRMED=false
JWT_SECRET=
CHAT_SESSION_SECRET=
RATE_LIMIT_KEY_SECRET=
SESSION_FINGERPRINT_SECRET=
SECURITY_EVENT_KEY_SECRET=
COOKIE_DOMAIN=
NODE_ENV=
PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
STORE_NAME=Your Store
STORE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com
STORE_CURRENCY=USD
STORE_LOCALE=en-US
STORE_TIMEZONE=UTC
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_USERNAME=
ALLOW_OWNER_MIGRATION=false
TRUST_PROXY_CIDRS=loopback
JSON_BODY_LIMIT=1mb
PAYMENT_PROVIDER=stripe
# This integration uses Stripe-hosted Checkout. The browser is redirected to
# Stripe, so a publishable key is not required by this flow.
STRIPE_SECRET_KEY=
# Separate signing secret from the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
CHECKOUT_CURRENCY=USD
# Optional when the backend and frontend are deployed separately. In this
# repository the backend automatically reads fend/data/customer-email-journey.json.
MARKETING_JOURNEY_PATH=
MARKETING_EMAIL_AUTOMATION_ENABLED=true
MARKETING_EMAIL_POLL_INTERVAL_MS=60000
OWNER_EMAIL=owner@example.com
MAX_CART_QUANTITY=99
MALWARE_SCANNER_MODE=clamav
MALWARE_SCAN_TIMEOUT_MS=30000
GRAPHQL_ENABLED=false
CJ_API_TOKEN=
CJ_API_BASE_URL=
CJ_API_TOKEN_URL=
# Custom websites use CJ's API store flow. Imports save products and
# variants to CJ and then create a product connection.
CJ_STORE_SYNC_ENABLED=true
# Optional when more than one CJ shop exists; blank uses the account API shop.
CJ_SHOP_ID=
CJ_PRODUCT_CONNECTION_LOGISTICS=PacketPlus
CJ_CONNECTION_DEFAULT_AREA=1
CJ_CONNECTION_IGNORE_INVENTORY=0
CJ_SOURCE_COUNTRY_CODE=CN
CJ_SOURCE_COUNTRY=China
CJ_TARGET_COUNTRY_CODE=US
CJ_TARGET_COUNTRY=United States
# CJ fulfillment (server-only). Keep sandbox enabled while testing.
CJ_FULFILLMENT_ENABLED=false
CJ_SANDBOX_MODE=false
# Explicitly enables charging the CJ account balance after a successful
# customer payment. Must remain false while CJ_SANDBOX_MODE=true.
CJ_AUTO_PAY_ENABLED=false
CJ_FROM_COUNTRY_CODE=CN
CJ_LOGISTIC_NAME=
CJ_SHOP_LOGISTICS_TYPE=2
HYPERSKU_ENABLED=false
HYPERSKU_API_BASE_URL=https://api.hypersku.com
HYPERSKU_API_KEY=
HYPERSKU_ACCESS_TOKEN=
HYPERSKU_USERNAME=
HYPERSKU_PASSWORD=
HYPERSKU_TOKEN_URL=https://api.hypersku.com/api/auth/admin/token
HYPERSKU_AUTH_HEADER_PREFIX=
HYPERSKU_STORE_CODE=
HYPERSKU_REQUEST_TIMEOUT_MS=20000
HYPERSKU_REQUEST_MIN_INTERVAL_MS=250
